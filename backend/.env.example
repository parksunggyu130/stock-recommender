# 서버가 사용하는 환경변수. 복사해서 .env 로 저장 후 값을 채우세요.

# DB 연결 문자열 (기본: 로컬 SQLite 파일)
DATABASE_URL=sqlite:///./data.db

# 스캔 대상 종목 수 (시가총액 상위 N)
UNIVERSE_SIZE=500

# 네이버 오픈 API - 뉴스 검색용 (https://developers.naver.com/apps 에서 무료 발급)
# 비워두면 뉴스 점수 없이 기술 점수만으로 top3를 정합니다.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 웹 푸시(VAPID) 키 - backend/app/scripts/generate_vapid_keys.py 로 생성
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=mailto:example@example.com

# (선택, 추천) 디스코드 웹후크 URL - 설정하면 07시/16시 알림을 디스코드로도 보냅니다.
# 브라우저 푸시보다 설정이 훨씬 간단합니다 (디스코드 채널 설정 > 연동 > 웹후크 > 새 웹후크).
DISCORD_WEBHOOK_URL=

# 외부 크론(cron-job.org 등)이 /api/cron/daily 를 호출할 때 사용하는 비밀 토큰
CRON_SECRET=change-this-secret

# 서버 프로세스 안에서 APScheduler로도 매일 07:00 KST 실행할지 여부
# 외부 크론(cron-job.org)만 쓸 경우 false로 두어 중복 발송을 막으세요.
RUN_INPROCESS_SCHEDULER=true
